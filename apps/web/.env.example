# Frontend environment template (Next.js reads env files from THIS folder, apps/web).
#
# Optional: the defaults below already work for local development.
# To override, copy to `.env.local` here:
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# Anything starting with NEXT_PUBLIC_ is embedded in the browser bundle and visible to everyone.
# NEVER put passwords, tokens or API secrets in these variables.
# These values are read at BUILD time: restart `npm run dev` / re-run `npm run build` after changes.

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. MapLibre style URL. Defaults to OpenFreeMap "Liberty" (no API key needed).
# If you switch provider, update the attribution in docs/MAP_BASEMAP.md and the UI credits.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
