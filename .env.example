# Digital India Atlas - environment template.
# Copy to `.env` (Windows PowerShell: Copy-Item .env.example .env) and set your own values.
# `.env` is git-ignored. NEVER commit real passwords, tokens or API keys.

# ---- Application ----
APP_ENV=development                 # development | test | production

# ---- PostgreSQL / PostGIS (read by docker-compose.yml) ----
POSTGRES_USER=atlas
POSTGRES_DB=atlas
# Choose a strong, unique password. Compose refuses to start if this is empty.
POSTGRES_PASSWORD=
# Host port is bound to 127.0.0.1 only (not reachable from other machines).
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
# Use the same user/password/db as above. URL-encode special characters in the password.
# Example shape: postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
