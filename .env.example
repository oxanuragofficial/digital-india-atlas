# Digital India Atlas - backend and database environment template.
#
# Copy to `.env` in the repository root and set your own values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real passwords, tokens or API keys.
# Frontend settings are separate: see apps/web/.env.example.

# development | test | production
APP_ENV=development

# ---- PostgreSQL / PostGIS (read by docker-compose.yml) ----
POSTGRES_USER=atlas
POSTGRES_DB=atlas
# REQUIRED. Choose a strong, unique password. Docker Compose refuses to start if it is empty.
# Tip: generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# (that alphabet is safe to paste into DATABASE_URL without URL-encoding)
POSTGRES_PASSWORD=
# The port is published on 127.0.0.1 only, so it is not reachable from other machines.
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
# Must use the same user, password, port and database name as above.
# Shape: postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
# Leave blank to run the API without a database (/health/db then reports "not_configured").
DATABASE_URL=
# Comma-separated browser origins allowed to call the API. Wildcards are rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
